# ETF网格交易策略分析系统环境变量配置
# 请复制此文件为 .env 并填入真实的配置值

# Tushare API Token。日常行情走 AkShare，留空也能启动。
# 只有代码真正调用 Tushare 时才要填写：https://tushare.pro/register
TUSHARE_TOKEN=

# Flask应用配置。调试器默认关闭，需要时再设 FLASK_DEBUG=1。
# 本机 start.sh 只监听 127.0.0.1；容器通过 HOST=0.0.0.0 对外绑定。
FLASK_ENV=development
FLASK_DEBUG=0
PORT=5001

# 可选。仓库里已经有 E大/网格3篇.md。文献放在别处时再填绝对路径。
# EDA_LITERATURE_PATH=

# 数据库。默认 SQLite，本机不用安装 MySQL。
DB_TYPE=sqlite
SQLITE_PATH=data/etf_grid.sqlite

# 改用 MySQL：把 DB_TYPE 改成 mysql，并填写账号。连不上时不会改回 SQLite。
# DB_TYPE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=etf_grid

# 日志级别
LOG_LEVEL=INFO

# 缓存配置
CACHE_TTL=3600
CACHE_MAXSIZE=1000
# 行情缓存目录。相对路径相对仓库根目录，不跟启动时的工作目录走。
# AKSHARE_CACHE_DIR=cache/akshare
