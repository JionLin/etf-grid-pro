# ETF网格交易策略分析系统环境变量配置
# 请复制此文件为 .env 并填入真实的配置值

# Tushare API Token (必须配置)
# 获取方式：https://tushare.pro/register
# 注意：必须配置有效的Token，系统不再支持模拟数据
TUSHARE_TOKEN=your_real_tushare_token_here

# Flask应用配置。调试器默认关闭，需要时再设 FLASK_DEBUG=1。
# 本机 start.sh 只监听 127.0.0.1；容器通过 HOST=0.0.0.0 对外绑定。
FLASK_ENV=development
FLASK_DEBUG=0
PORT=5001

# 本机 MySQL。复制到 .env 后填入本机账号，不要把真实密码提交进仓库。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=etf_grid

# 日志级别
LOG_LEVEL=INFO

# 缓存配置
CACHE_TTL=3600
CACHE_MAXSIZE=1000
